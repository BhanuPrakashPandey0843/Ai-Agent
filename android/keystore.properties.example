# Copy this file to "keystore.properties" (same folder) and fill in the
# real values. keystore.properties is git-ignored and must never be committed.
#
# RELEASE_STORE_FILE is resolved with rootProject.file(...), which is
# relative to android/ (this folder), NOT android/app/. Place the generated
# .keystore/.jks file directly in android/ (next to this file) and reference
# it by filename below.

RELEASE_STORE_FILE=release.keystore
RELEASE_STORE_PASSWORD=CHANGE_ME
RELEASE_KEY_ALIAS=CHANGE_ME
RELEASE_KEY_PASSWORD=CHANGE_ME
