rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Translation book metadata is public, but all catalog changes go through
    // the authenticated admin API.
    match /bibleBooks/{bookId} {
      allow read: if true;
      allow write: if false;
    }

    // Only published chapters are readable by the mobile app. A direct read
    // for a chapter that has not been published yet should return "not found"
    // rather than fail rule evaluation because resource is null. Drafts live
    // in bibleChapterDrafts and remain denied by the default rule.
    match /bibleChapters/{chapterId} {
      allow read: if resource == null || resource.data.status == 'published';
      allow write: if false;
    }

    match /bibleChapterDrafts/{chapterId} {
      allow read, write: if false;
    }

    // ------------------------------
    // EXISTING CONTENT COLLECTIONS
    // ------------------------------
    match /religiousWallpapers/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /dailyVerses/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /dailyPrayers/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /quotes/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /questions/{docId} {
      allow read: if request.auth != null && request.auth.token.isAdmin == true;
      allow write: if false;
    }
    match /studyPlans/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // BIBLE TAB CMS (added: previously unmatched -> denied by default)
    // ------------------------------
    match /bibleReadingPlans/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /bibleDailyVerses/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /bibleBanners/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /bibleAnnouncements/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /witnessPosts/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /meetSessions/{docId} {
      allow read: if true;
      allow write: if false;

      match /rsvps/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.response in ['going', 'not_going']
          && request.resource.data.keys().hasOnly(['response', 'updatedAt']);
        allow delete: if false;
      }
    }
    match /stories/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /featuredStories/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // WITNESS VIDEOS COLLECTIONS
    // ------------------------------
    match /witnessVideos/{docId} {
      allow read: if true;
      function interactionPath(uid) {
        return /databases/$(database)/documents/witnessVideos/$(docId)/userInteractions/$(uid);
      }
      function videoCountsMatchInteraction(oldState, newState, oldVideo, newVideo) {
        let oldLiked = oldState.liked == true;
        let oldDisliked = oldState.disliked == true;
        let newLiked = newState.liked == true;
        let newDisliked = newState.disliked == true;
        let likesBefore = ('likes' in oldVideo) ? oldVideo.likes : 0;
        let dislikesBefore = ('dislikes' in oldVideo) ? oldVideo.dislikes : 0;
        let viewsBefore = ('views' in oldVideo) ? oldVideo.views : 0;
        let likesAfter = ('likes' in newVideo) ? newVideo.likes : 0;
        let dislikesAfter = ('dislikes' in newVideo) ? newVideo.dislikes : 0;
        let viewsAfter = ('views' in newVideo) ? newVideo.views : 0;
        return newState.liked is bool
          && newState.disliked is bool
          && newState.viewed is bool
          && !(newLiked && newDisliked)
          && newVideo.updatedAt == request.time
          && (
            (newLiked != oldLiked
              && newDisliked == false
              && likesAfter - likesBefore == (newLiked ? 1 : -1)
              && dislikesAfter - dislikesBefore == (oldDisliked ? -1 : 0)
              && viewsAfter == viewsBefore
              && newState.viewed == (oldState.viewed == true))
            || (newDisliked != oldDisliked
              && newLiked == false
              && likesAfter - likesBefore == (oldLiked ? -1 : 0)
              && dislikesAfter - dislikesBefore == (newDisliked ? 1 : -1)
              && viewsAfter == viewsBefore
              && newState.viewed == (oldState.viewed == true))
            || (oldState.viewed != true
              && newState.viewed == true
              && newLiked == oldLiked
              && newDisliked == oldDisliked
              && likesAfter == likesBefore
              && dislikesAfter == dislikesBefore
              && viewsAfter - viewsBefore == 1)
          );
      }
      function videoCountersMatchNewState(newState, oldVideo, newVideo) {
        let newLiked = newState.liked == true;
        let newDisliked = newState.disliked == true;
        let likesBefore = ('likes' in oldVideo) ? oldVideo.likes : 0;
        let dislikesBefore = ('dislikes' in oldVideo) ? oldVideo.dislikes : 0;
        let viewsBefore = ('views' in oldVideo) ? oldVideo.views : 0;
        let likesAfter = ('likes' in newVideo) ? newVideo.likes : 0;
        let dislikesAfter = ('dislikes' in newVideo) ? newVideo.dislikes : 0;
        let viewsAfter = ('views' in newVideo) ? newVideo.views : 0;
        return newState.liked is bool
          && newState.disliked is bool
          && newState.viewed is bool
          && !(newLiked && newDisliked)
          && newState.updatedAt == request.time
          && newVideo.updatedAt == request.time
          && (
            (newLiked
              && likesAfter - likesBefore == 1
              && dislikesAfter - dislikesBefore in [-1, 0]
              && viewsAfter == viewsBefore)
            || (newDisliked
              && dislikesAfter - dislikesBefore == 1
              && likesAfter - likesBefore in [-1, 0]
              && viewsAfter == viewsBefore)
            || (!newLiked && !newDisliked
              && (
                (likesAfter - likesBefore == -1
                  && dislikesAfter == dislikesBefore
                  && viewsAfter == viewsBefore)
                || (dislikesAfter - dislikesBefore == -1
                  && likesAfter == likesBefore
                  && viewsAfter == viewsBefore)
                || (newState.viewed
                  && likesAfter == likesBefore
                  && dislikesAfter == dislikesBefore
                  && viewsAfter - viewsBefore == 1)
              ))
          );
      }
      function validVideoInteractionUpdate() {
        let path = request.auth != null
          ? interactionPath(request.auth.uid)
          : interactionPath('');
        return request.auth != null
          && existsAfter(path)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'dislikes', 'views', 'updatedAt'])
          && request.resource.data.likes is number
          && request.resource.data.dislikes is number
          && request.resource.data.views is number
          && request.resource.data.likes >= 0
          && request.resource.data.dislikes >= 0
          && request.resource.data.views >= 0
          && videoCountersMatchNewState(
            getAfter(path).data, resource.data, request.resource.data
          );
      }
      function validCommentCountUpdate() {
        let commentId = ('commentMutationId' in request.resource.data)
          ? request.resource.data.commentMutationId
          : '';
        let commentPath = /databases/$(database)/documents/witnessVideos/$(docId)/comments/$(commentId);
        let oldCount = ('commentCount' in resource.data) ? resource.data.commentCount : 0;
        return request.auth != null
          && commentId is string
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'commentMutationId'])
          && request.resource.data.commentCount is number
          && (
            (!exists(commentPath)
              && existsAfter(commentPath)
              && getAfter(commentPath).data.userId == request.auth.uid
              && request.resource.data.commentCount == oldCount + 1)
            || (exists(commentPath)
              && get(commentPath).data.userId == request.auth.uid
              && !existsAfter(commentPath)
              && request.resource.data.commentCount == oldCount - 1
              && oldCount > 0)
          );
      }
      allow create, delete: if false;
      allow update: if validVideoInteractionUpdate() || validCommentCountUpdate();

      match /userInteractions/{uid} {
        function hasMatchingExistingVideoCounters() {
          let videoPath = /databases/$(database)/documents/witnessVideos/$(docId);
          return request.auth != null
            && request.auth.uid == uid
            && getAfter(videoPath).data.diff(get(videoPath).data).affectedKeys().hasOnly(['likes', 'dislikes', 'views', 'updatedAt'])
            && videoCountsMatchInteraction(resource.data, request.resource.data, get(videoPath).data, getAfter(videoPath).data);
        }
        function hasMatchingNewVideoCounters() {
          let videoPath = /databases/$(database)/documents/witnessVideos/$(docId);
          return request.auth != null
            && request.auth.uid == uid
            && getAfter(videoPath).data.diff(get(videoPath).data).affectedKeys().hasOnly(['likes', 'dislikes', 'views', 'updatedAt'])
            && videoCountsMatchInteraction(
              { 'liked': false, 'disliked': false, 'viewed': false },
              request.resource.data,
              get(videoPath).data,
              getAfter(videoPath).data
            );
        }
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['liked', 'disliked', 'viewed', 'updatedAt'])
          && request.resource.data.liked is bool
          && request.resource.data.disliked is bool
          && request.resource.data.viewed is bool
          && !(request.resource.data.liked == true && request.resource.data.disliked == true)
          && request.resource.data.updatedAt == request.time
          && hasMatchingNewVideoCounters();
        allow update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['liked', 'disliked', 'viewed', 'updatedAt'])
          && request.resource.data.liked is bool
          && request.resource.data.disliked is bool
          && request.resource.data.viewed is bool
          && !(request.resource.data.liked == true && request.resource.data.disliked == true)
          && request.resource.data.updatedAt == request.time
          && hasMatchingExistingVideoCounters();
        allow delete: if false;
      }

      match /comments/{commentId} {
        function matchesVideoCommentCount(delta) {
          let videoPath = /databases/$(database)/documents/witnessVideos/$(docId);
          let oldVideo = get(videoPath).data;
          let newVideo = getAfter(videoPath).data;
          let oldCount = ('commentCount' in oldVideo) ? oldVideo.commentCount : 0;
          return newVideo.diff(oldVideo).affectedKeys().hasOnly(['commentCount', 'commentMutationId'])
            && newVideo.commentMutationId == commentId
            && newVideo.commentCount == oldCount + delta;
        }
        function matchesCommentLikeCount(delta) {
          let commentPath = /databases/$(database)/documents/witnessVideos/$(docId)/comments/$(commentId);
          let oldComment = get(commentPath).data;
          let newComment = getAfter(commentPath).data;
          let oldCount = ('likeCount' in oldComment) ? oldComment.likeCount : 0;
          return newComment.diff(oldComment).affectedKeys().hasOnly(['likeCount'])
            && newComment.likeCount == oldCount + delta;
        }
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.username.size() > 0
          && request.resource.data.username.size() <= 80
          && request.resource.data.photoURL is string
          && request.resource.data.text is string
          && request.resource.data.text.matches('.*\\S.*')
          && request.resource.data.text.size() <= 500
          && request.resource.data.likeCount == 0
          && request.resource.data.createdAt == request.time
          && matchesVideoCommentCount(1)
          && request.resource.data.keys().hasOnly([
            'userId', 'username', 'photoURL', 'text', 'likeCount', 'createdAt'
          ]);
        allow update: if request.auth != null
          && (
            (resource.data.userId == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
              && request.resource.data.text is string
              && request.resource.data.text.matches('.*\\S.*')
              && request.resource.data.text.size() <= 500
              && request.resource.data.editedAt == request.time)
            || validCommentLikeCountUpdate()
          );
        allow delete: if request.auth != null
          && resource.data.userId == request.auth.uid
          && matchesVideoCommentCount(-1);

        function validCommentLikeCountUpdate() {
          let uid = request.auth.uid;
          let likePath = /databases/$(database)/documents/witnessVideos/$(docId)/comments/$(commentId)/likes/$(uid);
          let oldCount = ('likeCount' in resource.data) ? resource.data.likeCount : 0;
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
            && request.resource.data.likeCount is number
            && (
              (!exists(likePath)
                && existsAfter(likePath)
                && getAfter(likePath).data.userId == uid
                && request.resource.data.likeCount == oldCount + 1)
              || (exists(likePath)
                && get(likePath).data.userId == uid
                && !existsAfter(likePath)
                && request.resource.data.likeCount == oldCount - 1
                && oldCount > 0)
            );
        }

        match /likes/{uid} {
          allow read: if true;
          allow create: if request.auth != null
            && request.auth.uid == uid
            && request.resource.data.userId == uid
            && request.resource.data.createdAt == request.time
            && matchesCommentLikeCount(1)
            && request.resource.data.keys().hasOnly(['userId', 'createdAt']);
          allow update: if false;
          allow delete: if request.auth != null
            && request.auth.uid == uid
            && resource.data.userId == uid
            && matchesCommentLikeCount(-1);
        }
      }
    }
    match /witnessCarousel/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // Bible Content
    // ------------------------------
    match /bibleContent/{docId} {
      allow read: if true;
      allow write: if false;

      match /userInteractions/{uid} {
        allow read, create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['liked', 'disliked', 'viewed', 'updatedAt'])
          && request.resource.data.liked is bool
          && request.resource.data.disliked is bool
          && request.resource.data.viewed is bool
          && !(request.resource.data.liked == true && request.resource.data.disliked == true);
        allow delete: if false;
      }
    }
    match /bibleCarousel/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // Jesus Content
    // ------------------------------
    match /jesusContent/{docId} {
      allow read: if true;
      allow write: if false;

      match /userInteractions/{uid} {
        allow read, create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['liked', 'disliked', 'viewed', 'updatedAt'])
          && request.resource.data.liked is bool
          && request.resource.data.disliked is bool
          && request.resource.data.viewed is bool
          && !(request.resource.data.liked == true && request.resource.data.disliked == true);
        allow delete: if false;
      }
    }
    match /jesusCarousel/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // Prayers Content
    // ------------------------------
    match /prayersContent/{docId} {
      allow read: if true;
      allow write: if false;

      match /userInteractions/{uid} {
        allow read, create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['liked', 'disliked', 'viewed', 'updatedAt'])
          && request.resource.data.liked is bool
          && request.resource.data.disliked is bool
          && request.resource.data.viewed is bool
          && !(request.resource.data.liked == true && request.resource.data.disliked == true);
        allow delete: if false;
      }
    }
    match /prayersCarousel/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // User-Submitted Prayers
    // ------------------------------
    match /userPrayers/{docId} {
      // Legacy documents have no `category`; they are all community requests.
      function prayerCategory(data) {
        return ('category' in data) ? data.category : 'community';
      }
      // Optional YYYY-MM-DD day a prayer belongs to (Personal prayers).
      function validPrayerDate(data) {
        return !('displayDate' in data)
          || (data.displayDate is string && data.displayDate.size() == 10);
      }

      // Owner can always read their own; ANY authenticated user can read it
      // once approved (Community Prayer Requests in the Prayer Room).
      // Personal prayers (status 'private') are therefore readable only by their
      // owner (and admins).
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId || resource.data.status == 'approved' || isAdmin(request.auth.uid));
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.anonymous is bool
        // Community requests start 'pending' (moderated). Personal prayers are
        // private to their owner and never enter the moderation/approval flow.
        && (
          (request.resource.data.status == "pending"
            && (!('category' in request.resource.data) || request.resource.data.category == 'community'))
          || (request.resource.data.status == "private"
            && request.resource.data.category == 'personal'
            && request.resource.data.anonymous == false)
        )
        && request.resource.data.username is string
        && validPrayerDate(request.resource.data)
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'content',
          'anonymous', 'status', 'userId', 'username',
          'createdAt', 'deviceTimestamp', 'prayCount', 'commentCount',
          'displayDate'
        ]);
      // Admin approve/reject (any field set), OR any authenticated user
      // nudging prayCount/commentCount by at most 1 on an approved doc.
      allow update: if request.auth != null && isAdmin(request.auth.uid)
        && request.resource.data.keys().hasAny(['status', 'updatedAt'])
        || (
          request.auth != null
          && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayCount', 'commentCount', 'updatedAt'])
          && request.resource.data.prayCount is number
          && request.resource.data.commentCount is number
          && (request.resource.data.prayCount - (('prayCount' in resource.data) ? resource.data.prayCount : 0)) in [-1, 0, 1]
          && (request.resource.data.commentCount - (('commentCount' in resource.data) ? resource.data.commentCount : 0)) in [0, 1]
        )
        // Owner edits their own prayer. The category and owner can never change,
        // and an edited community prayer goes back to 'pending' so approved
        // content cannot be swapped after moderation.
        || (
          request.auth != null
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'description', 'content', 'anonymous', 'username',
            'displayDate', 'status', 'updatedAt'
          ])
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 300
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 5000
          && request.resource.data.anonymous is bool
          && request.resource.data.username is string
          && validPrayerDate(request.resource.data)
          && (
            (prayerCategory(resource.data) == 'personal'
              && request.resource.data.status == 'private')
            || (prayerCategory(resource.data) != 'personal'
              && request.resource.data.status == 'pending')
          )
        );
      allow delete: if request.auth != null
        && (isAdmin(request.auth.uid) || request.auth.uid == resource.data.userId);

      match /prayingUsers/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['praying', 'updatedAt'])
          && request.resource.data.praying is bool;
        allow delete: if false;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.keys().hasOnly(['userId', 'username', 'text', 'createdAt']);
        allow update, delete: if false;
      }
    }

    // ------------------------------
    // Worship Content
    // ------------------------------
    match /worshipContent/{docId} {
      allow read: if true;
      allow write: if false;

      match /userInteractions/{uid} {
        allow read, create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['liked', 'disliked', 'viewed', 'updatedAt'])
          && request.resource.data.liked is bool
          && request.resource.data.disliked is bool
          && request.resource.data.viewed is bool
          && !(request.resource.data.liked == true && request.resource.data.disliked == true);
        allow delete: if false;
      }
    }
    match /worshipCarousel/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /contactMessages/{docId} {
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if false;
    }
    match /leaderboards/{boardId} {
      allow read: if true;
      allow write: if false;

      match /entries/{entryId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'photoURL', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'photoURL', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048;
      allow delete: if false;
    }

    // ------------------------------
    // CORE USER DATA
    // ------------------------------
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Create: new signup docs only contain profile fields (no resource.* compares).
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'address', 'photoURL', 'updatedAt', 'isPremium', 'coins', 'lastScore', 'lastPlayed', 'createdAt'])
        && (!('name' in request.resource.data) || request.resource.data.name is string)
        && (!('email' in request.resource.data) || request.resource.data.email is string)
        && (!('address' in request.resource.data) || request.resource.data.address is string)
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string);
      // Quiz results and profile stats are written only by trusted Cloud Functions.
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'email', 'address', 'photoURL', 'updatedAt'
        ])
        && (!('name' in request.resource.data) || request.resource.data.name is string)
        && (!('email' in request.resource.data) || request.resource.data.email is string)
        && (!('address' in request.resource.data) || request.resource.data.address is string)
        && (!('photoURL' in request.resource.data) || request.resource.data.photoURL is string);

      match /attemptedQuestions/{questionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if false;
        allow update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read', 'readAt', 'opened', 'openedAt'
          ]);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }
      match /quizSessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
      match /favorites/{wallpaperId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /bookmarks/{storyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /savedVideos/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /likedVideos/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /dislikedVideos/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ------------------------------
    // WALLPAPER PREFERENCES (mobile: Settings -> Wallpaper Settings)
    // ------------------------------
    // One document per user, keyed by uid - same ownership model as
    // /users/{userId} above. This collection previously had no match block at
    // all, so every read and write from the Wallpaper Settings screen was
    // denied by default ('Missing or insufficient permissions'). Shape is
    // validated so the document can only ever hold the five preference fields
    // the screen actually writes.
    match /wallpaper_preferences/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'categories', 'quality', 'downloadPreference',
          'autoWallpaper', 'smartRecommendations'
        ])
        && (!('categories' in request.resource.data) || request.resource.data.categories is map)
        && (!('quality' in request.resource.data) || request.resource.data.quality is string)
        && (!('downloadPreference' in request.resource.data) || request.resource.data.downloadPreference is string)
        && (!('autoWallpaper' in request.resource.data) || request.resource.data.autoWallpaper is string)
        && (!('smartRecommendations' in request.resource.data) || request.resource.data.smartRecommendations is bool);
      allow delete: if false;
    }

    // ------------------------------
    // SUBSCRIPTIONS
    // ------------------------------
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ------------------------------
    // PAYMENTS
    // ------------------------------
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ------------------------------
    // AUDIT LOGS
    // ------------------------------
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // ------------------------------
    // ADMIN USERS
    // ------------------------------
    match /adminUsers/{adminId} {
      allow read, write: if false;
    }

    // ------------------------------
    // SUPPORT TICKETS
    // ------------------------------
    match /supportTickets/{ticketId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin(request.auth.uid));
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 200
        && request.resource.data.status == 'open'
        && request.resource.data.priority in ['low', 'medium', 'high', 'urgent'];
      allow update: if request.auth != null
        && (isAdmin(request.auth.uid) || resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // ------------------------------
    // ANALYTICS
    // ------------------------------
    match /analytics/dailyStats/{dateStr} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // SYSTEM SETTINGS
    // ------------------------------
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // NOTIFICATIONS
    // ------------------------------
    // Written only by the admin panel (Admin SDK, bypasses rules). Each document is
    // addressed to one user via `userId`; users can read their own, mark them read
    // (only the `read` field may change) and delete them.
    match /notifications/{notificationId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if false;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    // Per-user switches from Notifications -> Preferences. The admin reminder sender
    // honours `premium` ("Premium Content"); an explicit false means opted out.
    match /notification_preferences/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'version', 'pushEnabled', 'push', 'inApp', 'updatedAt',
          'dailyVerse', 'prayerReminder', 'bibleReading', 'quizReminder', 'newWallpaper',
          'community', 'appUpdates', 'promo', 'premium'
        ])
        && (!('pushEnabled' in request.resource.data) || request.resource.data.pushEnabled is bool)
        && (!('push' in request.resource.data) || request.resource.data.push is map)
        && (!('inApp' in request.resource.data) || request.resource.data.inApp is map);
      allow delete: if false;
    }

    match /pushTokens/{tokenId} {
      allow read: if request.auth != null
        && (!exists(/databases/$(database)/documents/pushTokens/$(tokenId))
          || resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.token == tokenId
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 200
        && request.resource.data.active is bool
        && request.resource.data.platform in ['android', 'ios']
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'token', 'active', 'platform', 'createdAt', 'updatedAt'
        ]);
      // A device token is unguessable and only ever known to the device that generated it, and one
      // device can be signed in to one account at a time. So whoever presents it is its current
      // holder: signing in as another account on the same phone must be able to re-point the token
      // at itself, otherwise the previous account keeps receiving this phone's notifications and the
      // new account never gets any. Reads and deletes stay owner-only.
      allow update: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.token == tokenId
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 200
        && request.resource.data.active is bool
        && request.resource.data.platform in ['android', 'ios']
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'token', 'active', 'platform', 'createdAt', 'updatedAt'
        ]);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    match /notificationCampaigns/{campaignId} {
      allow read, write: if false;
    }
    match /notificationDeliveries/{deliveryId} {
      allow read, write: if false;
    }
    match /notificationSettings/{settingId} {
      allow read, write: if false;
    }
    match /notificationRateLimits/{limitId} {
      allow read, write: if false;
    }
    match /notificationIdempotency/{requestId} {
      allow read, write: if false;
    }

    // ------------------------------
    // HELPER FUNCTIONS
    // ------------------------------
    function isAdmin(uid) {
      return request.auth != null && request.auth.token.isAdmin == true;
    }
    function isSuperAdmin(uid) {
      return request.auth != null && request.auth.token.role == 'super_admin';
    }
  }
}
