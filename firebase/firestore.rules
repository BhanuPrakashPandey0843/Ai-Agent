rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------
    // EXISTING CONTENT COLLECTIONS
    // ------------------------------
    match /religiousWallpapers/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /dailyVerses/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /dailyPrayers/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /quotes/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /questions/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /studyPlans/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // BIBLE TAB CMS (added: previously unmatched -> denied by default)
    // ------------------------------
    match /bibleReadingPlans/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /bibleDailyVerses/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /bibleBanners/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /bibleAnnouncements/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /witnessPosts/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /meetSessions/{docId} {
      allow read: if true;
      allow write: if false;

      match /rsvps/{uid} {
        allow read: if true;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.response in ['going', 'not_going']
          && request.resource.data.keys().hasOnly(['response', 'updatedAt']);
        allow delete: if false;
      }
    }
    match /stories/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /featuredStories/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // WITNESS VIDEOS COLLECTIONS
    // ------------------------------
    match /witnessVideos/{docId} {
      allow read: if true;
      allow write: if false;

      match /userInteractions/{uid} {
        allow read, create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['liked', 'disliked', 'viewed', 'updatedAt'])
          && request.resource.data.liked is bool
          && request.resource.data.disliked is bool
          && request.resource.data.viewed is bool
          && !(request.resource.data.liked == true && request.resource.data.disliked == true);
        allow delete: if false;
      }
    }
    match /witnessCarousel/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // Bible Content
    // ------------------------------
    match /bibleContent/{docId} {
      allow read: if true;
      allow write: if false;

      match /userInteractions/{uid} {
        allow read, create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['liked', 'disliked', 'viewed', 'updatedAt'])
          && request.resource.data.liked is bool
          && request.resource.data.disliked is bool
          && request.resource.data.viewed is bool
          && !(request.resource.data.liked == true && request.resource.data.disliked == true);
        allow delete: if false;
      }
    }
    match /bibleCarousel/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // Jesus Content
    // ------------------------------
    match /jesusContent/{docId} {
      allow read: if true;
      allow write: if false;

      match /userInteractions/{uid} {
        allow read, create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['liked', 'disliked', 'viewed', 'updatedAt'])
          && request.resource.data.liked is bool
          && request.resource.data.disliked is bool
          && request.resource.data.viewed is bool
          && !(request.resource.data.liked == true && request.resource.data.disliked == true);
        allow delete: if false;
      }
    }
    match /jesusCarousel/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // Prayers Content
    // ------------------------------
    match /prayersContent/{docId} {
      allow read: if true;
      allow write: if false;

      match /userInteractions/{uid} {
        allow read, create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['liked', 'disliked', 'viewed', 'updatedAt'])
          && request.resource.data.liked is bool
          && request.resource.data.disliked is bool
          && request.resource.data.viewed is bool
          && !(request.resource.data.liked == true && request.resource.data.disliked == true);
        allow delete: if false;
      }
    }
    match /prayersCarousel/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // User-Submitted Prayers
    // ------------------------------
    match /userPrayers/{docId} {
      // Owner can always read their own; ANY authenticated user can read it
      // once approved (Community Prayer Requests in the Prayer Room).
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.userId || resource.data.status == 'approved' || isAdmin(request.auth.uid));
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 300
        && request.resource.data.category is string
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 5000
        && request.resource.data.anonymous is bool
        && request.resource.data.status == "pending"
        && request.resource.data.username is string
        && request.resource.data.keys().hasOnly([
          'title', 'description', 'category', 'content',
          'anonymous', 'status', 'userId', 'username',
          'createdAt', 'deviceTimestamp', 'prayCount', 'commentCount'
        ]);
      // Admin approve/reject (any field set), OR any authenticated user
      // nudging prayCount/commentCount by at most 1 on an approved doc.
      allow update: if request.auth != null && isAdmin(request.auth.uid)
        && request.resource.data.keys().hasAny(['status', 'updatedAt'])
        || (
          request.auth != null
          && resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayCount', 'commentCount', 'updatedAt'])
          && request.resource.data.prayCount is number
          && request.resource.data.commentCount is number
          && (request.resource.data.prayCount - (('prayCount' in resource.data) ? resource.data.prayCount : 0)) in [-1, 0, 1]
          && (request.resource.data.commentCount - (('commentCount' in resource.data) ? resource.data.commentCount : 0)) in [0, 1]
        );
      allow delete: if request.auth != null
        && (isAdmin(request.auth.uid) || request.auth.uid == resource.data.userId);

      match /prayingUsers/{uid} {
        allow read: if request.auth != null;
        allow create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['praying', 'updatedAt'])
          && request.resource.data.praying is bool;
        allow delete: if false;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.username is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.keys().hasOnly(['userId', 'username', 'text', 'createdAt']);
        allow update, delete: if false;
      }
    }

    // ------------------------------
    // Worship Content
    // ------------------------------
    match /worshipContent/{docId} {
      allow read: if true;
      allow write: if false;

      match /userInteractions/{uid} {
        allow read, create, update: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['liked', 'disliked', 'viewed', 'updatedAt'])
          && request.resource.data.liked is bool
          && request.resource.data.disliked is bool
          && request.resource.data.viewed is bool
          && !(request.resource.data.liked == true && request.resource.data.disliked == true);
        allow delete: if false;
      }
    }
    match /worshipCarousel/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /contactMessages/{docId} {
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if false;
    }
    match /leaderboards/{boardId}/entries/{entryId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == entryId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 50000
        && request.resource.data.accuracy is number
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100;
    }

    // ------------------------------
    // CORE USER DATA
    // ------------------------------
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['name', 'email', 'address', 'photoURL', 'updatedAt', 'isPremium', 'coins', 'lastScore', 'lastPlayed', 'createdAt'])
        && (!request.resource.data.name || request.resource.data.name is string)
        && (!request.resource.data.email || request.resource.data.email is string)
        && (!request.resource.data.address || request.resource.data.address is string)
        && (!request.resource.data.photoURL || request.resource.data.photoURL is string)
        && (!request.resource.data.isPremium || request.resource.data.isPremium == resource.data.isPremium)
        && (!request.resource.data.coins || request.resource.data.coins == resource.data.coins)
        && (!request.resource.data.lastScore || request.resource.data.lastScore == resource.data.lastScore)
        && (!request.resource.data.lastPlayed || request.resource.data.lastPlayed == resource.data.lastPlayed)
        && (!request.resource.data.createdAt || request.resource.data.createdAt == resource.data.createdAt);

      match /attemptedQuestions/{questionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /quizSessions/{sessionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
          && request.resource.data.status == 'completed'
          && request.resource.data.sessionId == sessionId;
        allow update, delete: if false;
      }
      match /favorites/{wallpaperId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /bookmarks/{storyId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /savedVideos/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /likedVideos/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /dislikedVideos/{videoId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ------------------------------
    // SUBSCRIPTIONS
    // ------------------------------
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ------------------------------
    // PAYMENTS
    // ------------------------------
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // ------------------------------
    // AUDIT LOGS
    // ------------------------------
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // ------------------------------
    // ADMIN USERS
    // ------------------------------
    match /adminUsers/{adminId} {
      allow read, write: if false;
    }

    // ------------------------------
    // SUPPORT TICKETS
    // ------------------------------
    match /supportTickets/{ticketId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || isAdmin(request.auth.uid));
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.subject is string
        && request.resource.data.subject.size() <= 200
        && request.resource.data.status == 'open'
        && request.resource.data.priority in ['low', 'medium', 'high', 'urgent'];
      allow update: if request.auth != null
        && (isAdmin(request.auth.uid) || resource.data.userId == request.auth.uid);
      allow delete: if false;
    }

    // ------------------------------
    // ANALYTICS
    // ------------------------------
    match /analytics/dailyStats/{dateStr} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // SYSTEM SETTINGS
    // ------------------------------
    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if false;
    }

    // ------------------------------
    // HELPER FUNCTIONS
    // ------------------------------
    function isAdmin(uid) {
      return request.auth != null && request.auth.token.isAdmin == true;
    }
    function isSuperAdmin(uid) {
      return request.auth != null && request.auth.token.role == 'super_admin';
    }
  }
}
