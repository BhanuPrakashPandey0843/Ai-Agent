{
  "name": "faithframes-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "set NODE_OPTIONS=--max-old-space-size=4096 && expo start --clear",
    "android": "expo run:android",
    "android:go": "set NODE_OPTIONS=--max-old-space-size=4096 && expo start --android --clear",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "clean": "npx expo-doctor && npx expo install --fix",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "@shopify/flash-list": "1.6.4",
    "@types/react": "~18.2.79",
    "axios": "^1.7.2",
    "expo": "~51.0.39",
    "expo-av": "~14.0.7",
    "expo-blur": "~13.0.2",
    "expo-clipboard": "~6.0.3",
    "expo-constants": "~16.0.2",
    "expo-file-system": "~17.0.1",
    "expo-font": "~12.0.10",
    "expo-haptics": "~13.0.1",
    "expo-image": "~1.13.0",
    "expo-image-picker": "~15.1.0",
    "expo-linear-gradient": "~13.0.2",
    "expo-media-library": "~16.0.4",
    "expo-notifications": "~0.28.18",
    "expo-secure-store": "~13.0.2",
    "expo-sharing": "~12.0.1",
    "expo-speech": "~12.0.2",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "firebase": "10.7.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-svg": "15.2.0",
    "react-native-url-polyfill": "^2.0.0",
    "typescript": "~5.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "patch-package": "^8.0.1"
  },
  "private": true
}
