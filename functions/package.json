{
  "name": "faithframes-functions",
  "version": "1.0.0",
  "description": "Cloud Functions for FaithFrames Premium Subscription System",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1",
    "razorpay": "^2.9.4",
    "stripe": "^16.12.0",
    "crypto": "^1.0.1",
    "axios": "^1.7.2"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "typescript": "^5.6.3",
    "firebase-functions-test": "^3.3.0"
  },
  "private": true
}
