# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=wallpaper-c74a3
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Quiz API (Next.js admin deployment that serves POST /api/quiz).
# Defaults to https://www.faithframes.online. For local testing, run the admin
# panel (`npm run dev` in FaithFrames/my-app) and use http://localhost:3000.
# Android emulator cannot reach localhost; use http://10.0.2.2:3000 there.
# EXPO_PUBLIC_QUIZ_API_BASE_URL=https://www.faithframes.online

# Optional: force Firestore long-polling if firestore.googleapis.com
# .../Listen/channel fails with ERR_CONNECTION_CLOSED on your network.
# EXPO_PUBLIC_FIRESTORE_FORCE_LONG_POLLING=true

# Payment Gateway Keys (Client Side)
EXPO_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
